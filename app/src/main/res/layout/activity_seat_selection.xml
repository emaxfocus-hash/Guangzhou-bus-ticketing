<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/selectedRouteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected route"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select your preferred seat"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:columnCount="4"
            android:rowCount="3"
            android:useDefaultMargins="true">

            <Button
                android:id="@+id/seat1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="1" />

            <Button
                android:id="@+id/seat2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="2" />

            <Button
                android:id="@+id/seat3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="3" />

            <Button
                android:id="@+id/seat4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="4" />

            <Button
                android:id="@+id/seat5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="5" />

            <Button
                android:id="@+id/seat6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="6" />

            <Button
                android:id="@+id/seat7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="7" />

            <Button
                android:id="@+id/seat8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="8" />

            <Button
                android:id="@+id/seat9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="9" />

            <Button
                android:id="@+id/seat10"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="10" />

            <Button
                android:id="@+id/seat11"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="11" />

            <Button
                android:id="@+id/seat12"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_columnWeight="1"
                android:backgroundTint="@color/primary_blue"
                android:text="12" />
        </GridLayout>

        <TextView
            android:id="@+id/selectedSeatsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="No seats selected yet"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/continuePaymentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/accent_orange"
            android:text="Continue to payment" />
    </LinearLayout>
</ScrollView>
